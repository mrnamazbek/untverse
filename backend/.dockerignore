# ==============================================================================
# UNTverse Backend — .dockerignore
# ==============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
env/

# Tests & docs (not needed in production image)
tests/
docs/
*.md
pytest.ini

# Git
.git/
.gitignore

# IDE
.idea/
.vscode/
*.swp
*.swo

# Environment files (secrets — must NOT be in image)
.env
.env.*
!.env.example

# Database files (local dev only)
*.db
*.sqlite3

# Docker
Dockerfile
docker-compose*.yml
.dockerignore

# CI/CD
.github/

# Misc
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
coverage.xml
