# ==============================================================================
# UNTverse - Environment Configuration Template
# Copy this file to .env before starting the stack
# ==============================================================================

# Backend Configuration
ENVIRONMENT=development
PORT=8000
DATABASE_URL=postgresql+asyncpg://unt_user:unt_secure_password_2026@localhost:5432/unt_informatics
# For SQLite local fallback: sqlite+aiosqlite:///./unt_informatics.db

JWT_SECRET=change_me_to_a_random_secure_hex_string_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
